# ─────────────────────────────────────────────────────────────────────────────
# StockMinded — environment variable template.
#
# L6 FIX: this file previously documented only 5 of the ~25 variables the app
# actually consumes. Every consumed variable is documented below (NO values —
# copy this file to `.env` and fill in your own secrets). `.env` is gitignored.
#
# Any variable may be left blank: the app is designed to boot in alerts-only /
# paper-trade mode and degrades gracefully when a credential is missing
# (see config/loader.py _REQUIRED_ENV_VARS and the fallbacks in data/*, ops/*).
# ─────────────────────────────────────────────────────────────────────────────

# ── Generic broker (config.yaml: broker.api_key / api_secret / access_token) ──
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ACCESS_TOKEN=

# ── Dhan broker (config.yaml: broker.dhan.*) ──────────────────────────────────
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# ── Shoonya / Finvasia broker (data/shoonya_fetcher.py OAuth + TOTP) ──────────
# Full brokerage credentials. Treat as highly sensitive.
SHOONYA_USER_ID=
SHOONYA_PASSWORD=
SHOONYA_API_SECRET=
SHOONYA_TOTP_KEY=
# Optional: number of strikes fetched around ATM (default 10).
STRIKES_AROUND_ATM=

# ── Telegram alerts (config.yaml: alerts.*) ───────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Discord notifications (data/notifier.py broadcast) ────────────────────────
DISCORD_WEBHOOK_URL=

# ── LLM / AI providers (config.yaml: data_sources.scrapegraphai.*) ────────────
# Used by data/ai_scraper.py call_llm(); the engine falls back across providers.
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
SAMBANOVA_API_KEY=
NVIDIA_API_KEY=
SCRAPEGRAPHAI_API_KEY=
OPENCODE_API_KEY=
HF_API_TOKEN=
BEDROCK_API_KEY=

# ── AWS (Bedrock backing for some LLM/scrape paths) ───────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Cloudflare (ScrapeGraphAI CF worker path) ─────────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ── GitHub (ScrapeGraphAI / repo access) ──────────────────────────────────────
GITHUB_TOKEN=

# ── News data sources ─────────────────────────────────────────────────────────
NEWSAPI_KEY=

# ── Runtime feature flags (read via os.getenv in dashboard/server.py) ─────────
# Set to "1"/"true" to serve investment.html as the root page instead of index.html.
INVESTMENT_ONLY=
